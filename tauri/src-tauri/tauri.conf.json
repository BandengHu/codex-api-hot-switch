{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex SwitchGate",
  "version": "0.2.11",
  "identifier": "local.codex.switchgate.tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex SwitchGate",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/server/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
